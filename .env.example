# ---------------------------------------------------------------
# Majestic Arabian - environment variables
# Copy this file to .env.local for local development.
# On Vercel: Project > Settings > Environment Variables.
# Never commit real secrets. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://majesticarabianstore.com

# Store settings (shown in the UI)
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=60
NEXT_PUBLIC_SUPPORT_EMAIL=support@majesticarabianstore.com
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/

# Set to "false" once you have real customer reviews to hide the sample reviews
NEXT_PUBLIC_SHOW_SAMPLE_REVIEWS=true

# ---------------- Shopify Storefront API (server-side only) -----
# Leave empty to run on the local mock catalogue (lib/data/products.ts).
# When BOTH are set, products/collections/checkout come from Shopify.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10

# ---------------- Newsletter (server-side only) -----------------
# Any webhook that accepts JSON {"email": "..."} (Zapier, Make, Klaviyo flow, Formspree...)
NEWSLETTER_WEBHOOK_URL=
